<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gov.municipio.controller.EventosController"
      styleClass="content-container"
      stylesheets="@../css/material-base.css,@../css/material-components.css">
    
    <Label text="Eventos" styleClass="text-headline-medium"/>
    
    <Button fx:id="btnCrearEvento" text="Crear Nuevo Evento" onAction="#crearEvento" styleClass="btn-primary"/>
    
    <VBox styleClass="section-container">

      <Label text="Eventos registrados" styleClass="text-title-medium"/>

      <Button fx:id="btnGestionarEvento" text="Gestionar Evento" onAction="#gestionarEvento" styleClass="btn-secondary"/>

      <TableView fx:id="tblEventos" styleClass="table-view">
          <columns>
              <TableColumn text="Nombre" fx:id="colNombre"/>
              <TableColumn text="Fecha de Inicio" fx:id="colFechaInicio"/>
              <TableColumn text="Duración (horas)" fx:id="colDuracion"/>
              <TableColumn text="Tipo de Evento" fx:id="colTipoEvento"/>
              <TableColumn text="Estado" fx:id="colEstado"/>
          </columns>
      </TableView>

    </VBox>

</VBox>
