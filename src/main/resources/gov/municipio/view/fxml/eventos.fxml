<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gov.municipio.controller.EventosController"
      spacing="20">
    
    <Label text="Eventos"/>
    
    <Button fx:id="btnCrearEvento" text="Crear Nuevo Evento" onAction="#crearEvento"/>
    
    <VBox spacing="10">

      <Label text="Eventos registrados"/>

      <Button fx:id="btnGestionarEvento" text="Gestionar Evento" onAction="#gestionarEvento"/>

      <TableView fx:id="tblEventos">
          <columns>
              <TableColumn text="Nombre" fx:id="colNombre"/>
              <TableColumn text="Fecha de Inicio" fx:id="colFechaInicio"/>
              <TableColumn text="Duración (horas)" fx:id="colDuracion"/>
              <TableColumn text="Tipo de Evento" fx:id="colTipoEvento"/>
          </columns>
      </TableView>

    </VBox>

</VBox>
