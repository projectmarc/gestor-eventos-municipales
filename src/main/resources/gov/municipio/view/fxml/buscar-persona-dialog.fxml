<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gov.municipio.controller.BuscarPersonaDialogController"
      spacing="15" prefWidth="350">
    
    <Label text="Agregar Responsable" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    
    <VBox spacing="10">
        <Label text="DNI de la persona:"/>
        <TextField fx:id="txtDni" promptText="Ingrese el DNI"/>
    </VBox>
    
    <Label fx:id="lblError" text="" style="-fx-text-fill: red;" visible="false" managed="false"/>
    
    <!-- Botones de acción -->
    <HBox spacing="10">
        <Button fx:id="btnAceptar" text="Agregar" onAction="#aceptar"/>
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar"/>
    </HBox>
    
</VBox>
