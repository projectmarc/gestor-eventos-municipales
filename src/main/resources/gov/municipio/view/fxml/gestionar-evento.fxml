<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gov.municipio.controller.GestionarEventoController"
      styleClass="content-container"
      stylesheets="@../css/material-base.css,@../css/material-components.css">
    
    <Label text="Gestionar Evento" styleClass="text-headline-medium"/>
    
    <!-- Estado del evento -->
    <HBox spacing="10" styleClass="padding-small">
        <Label text="Estado:" styleClass="text-label-large"/>
        <Label fx:id="lblEstado" text="" styleClass="text-label-large"/>
    </HBox>
    
    <HBox spacing="20">
        <!-- Primera sección: Detalles básicos del evento -->
        <VBox spacing="15" prefWidth="400" styleClass="section-container">
            <Label text="Detalles del Evento" styleClass="text-title-medium"/>
            
            <!-- Nombre -->
            <VBox spacing="5">
                <Label text="Nombre:" styleClass="text-label-large"/>
                <Label fx:id="lblNombre" text="" styleClass="text-body-large"/>
                <TextField fx:id="txtNombre" visible="false" managed="false"/>
            </VBox>
            
            <!-- Duración -->
            <VBox spacing="5">
                <Label text="Duración (horas):" styleClass="text-label-large"/>
                <Label fx:id="lblDuracion" text="" styleClass="text-body-large"/>
                <TextField fx:id="txtDuracion" visible="false" managed="false"/>
            </VBox>
            
            <!-- Fecha de Inicio -->
            <VBox spacing="5">
                <Label text="Fecha de Inicio:" styleClass="text-label-large"/>
                <Label fx:id="lblFechaInicio" text="" styleClass="text-body-large"/>
                <DatePicker fx:id="dpFechaInicio" visible="false" managed="false"/>
            </VBox>
            
            <!-- Cupo Máximo -->
            <VBox spacing="5">
                <Label text="Cupo Máximo:" styleClass="text-label-large"/>
                <Label fx:id="lblCupoMaximo" text="" styleClass="text-body-large"/>
                <TextField fx:id="txtCupoMaximo" visible="false" managed="false"/>
            </VBox>
            
            <!-- Botones de acción -->
            <HBox spacing="10">
                <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="btn-secondary"/>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" visible="false" managed="false" styleClass="btn-primary"/>
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" visible="false" managed="false" styleClass="btn-outlined"/>
                <Button fx:id="btnConfirmar" text="Confirmar Evento" onAction="#confirmarEvento" styleClass="btn-primary"/>
            </HBox>
        </VBox>
        
        <!-- Segunda sección: Personas Responsables -->
        <VBox spacing="15" prefWidth="400" styleClass="section-container">
            <Label text="Personas Responsables" styleClass="text-title-medium"/>
            
            <!-- Contenedor dinámico para los roles de responsables -->
            <VBox fx:id="vboxResponsables" spacing="10">
                <!-- Se llenarán dinámicamente según el tipo de evento -->
            </VBox>
        </VBox>
        
        <!-- Tercera sección: Asistentes -->
        <VBox spacing="15" prefWidth="400" styleClass="section-container">
            <Label text="Asistentes" styleClass="text-title-medium"/>
            
            <!-- Contenedor para los asistentes -->
            <VBox fx:id="vboxAsistentes" spacing="10">
                <!-- Se llenarán dinámicamente -->
            </VBox>
        </VBox>
        
        <!-- Cuarta sección: Películas/Artistas según el tipo de evento -->
        <VBox spacing="15" prefWidth="400" styleClass="section-container">
            <Label fx:id="lblTituloContenido" text="Contenido" styleClass="text-title-medium"/>
            
            <!-- Contenedor para películas o artistas -->
            <VBox fx:id="vboxContenido" spacing="10">
                <!-- Se llenarán dinámicamente según el tipo de evento -->
            </VBox>
        </VBox>
    </HBox>
    
    <!-- Botón para volver -->
    <Button text="Volver a Eventos" onAction="#volver" styleClass="btn-text"/>
    
</VBox>