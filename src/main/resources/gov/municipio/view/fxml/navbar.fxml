<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gov.municipio.controller.NavbarController">

    <children>
        <Label text="Sistema de Gestión de Eventos Culturales"/>
        <Button fx:id="btnInicio" text="Inicio" onAction="#onNavigate" userData="INICIO"/>
        <Button fx:id="btnEventos" text="Eventos" onAction="#onNavigate" userData="EVENTOS"/>
        <Button fx:id="btnPersonas" text="Personas" onAction="#onNavigate" userData="PERSONAS"/>
        <Button fx:id="btnPeliculas" text="Películas" onAction="#onNavigate" userData="PELICULAS"/>
        <Button fx:id="btnArtistasBandas" text="Artistas/Bandas" onAction="#onNavigate" userData="ARTISTAS_BANDAS"/>
    </children>
</HBox>
