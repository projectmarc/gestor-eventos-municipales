<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="main"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gov.municipio.controller.MainController"
            prefWidth="1400" prefHeight="800"
            styleClass="main-container"
            stylesheets="@../css/material-base.css,@../css/material-components.css,@../css/material-states.css">
    
    <!-- Barra de navegación superior -->
    <top>
        <fx:include source="navbar.fxml" fx:id="navbar"/>
    </top>

    <!-- Área de contenido dinámico -->
    <center>
        <StackPane fx:id="contentStack"/>
    </center>

    <!-- Calendario reutilizable a la derecha -->
    <right>
        
    </right>

    <!-- Barra de estado inferior -->
    <bottom>
        
    </bottom>
</BorderPane>
