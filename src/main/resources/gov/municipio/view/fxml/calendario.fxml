<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gov.municipio.controller.CalendarioController"
           prefWidth="1200" prefHeight="700"
           styleClass="content-container"
           stylesheets="@../css/material-base.css,@../css/material-components.css">
           
    <!-- Encabezado con título y navegación -->
    <top>
        <VBox spacing="15" alignment="CENTER" styleClass="padding-large">
            <Label text="Calendario de Eventos" styleClass="text-headline-medium"/>
            
            <!-- Navegación de meses -->
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnAnterior" text="&lt;" onAction="#mesAnterior" styleClass="btn-icon"/>
                <Label fx:id="lblMesAnio" text="AGOSTO 2025" styleClass="text-title-large" 
                       prefWidth="200" alignment="CENTER"/>
                <Button fx:id="btnSiguiente" text="&gt;" onAction="#mesSiguiente" styleClass="btn-icon"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Área principal: Calendario -->
    <center>
        <VBox spacing="10" alignment="CENTER" styleClass="section-container">
            <!-- Calendario en grid -->
            <GridPane fx:id="gridCalendario" 
                     hgap="2" vgap="2" 
                     alignment="CENTER"
                     styleClass="card">
                <!-- Las celdas se generan dinámicamente en el controlador -->
            </GridPane>
            
            <!-- Leyenda de colores -->
            <HBox spacing="20" alignment="CENTER" styleClass="padding-medium">
                <Label text="Leyenda:" styleClass="text-label-large"/>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="ORANGE"/>
                    <Label text="Planificación" styleClass="text-body-small"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="GREEN"/>
                    <Label text="Confirmado" styleClass="text-body-small"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="BLUE"/>
                    <Label text="En Ejecución" styleClass="text-body-small"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="GRAY"/>
                    <Label text="Finalizado" styleClass="text-body-small"/>
                </HBox>
            </HBox>
        </VBox>
    </center>
    
    <!-- Panel lateral derecho: Eventos del día seleccionado -->
    <right>
        <VBox spacing="15" prefWidth="300" styleClass="section-container">
            <Label text="Eventos del Día" styleClass="text-title-medium"/>
            
            <!-- Fecha seleccionada -->
            <Label fx:id="lblFechaSeleccionada" text="Seleccione una fecha" 
                   styleClass="text-body-medium" 
                   wrapText="true"/>
            
            <!-- Lista de eventos -->
            <ListView fx:id="listEventosDia" prefHeight="400">
                <!-- Los eventos se cargan dinámicamente -->
            </ListView>
            
            <!-- Instrucciones -->
            <Label text="Haga doble clic en un evento para gestionarlo" 
                   styleClass="text-body-small" 
                   wrapText="true"/>
        </VBox>
    </right>
    
</BorderPane>
