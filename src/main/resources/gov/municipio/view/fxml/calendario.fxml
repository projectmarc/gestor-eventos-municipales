<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gov.municipio.controller.CalendarioController"
           prefWidth="1200" prefHeight="700">
           
    <!-- Encabezado con título y navegación -->
    <top>
        <VBox spacing="15" alignment="CENTER">
            <Label text="Calendario de Eventos" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            
            <!-- Navegación de meses -->
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnAnterior" text="&lt;" onAction="#mesAnterior" 
                        style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label fx:id="lblMesAnio" text="AGOSTO 2025" 
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" 
                       prefWidth="200" alignment="CENTER"/>
                <Button fx:id="btnSiguiente" text="&gt;" onAction="#mesSiguiente" 
                        style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Área principal: Calendario -->
    <center>
        <VBox spacing="10" alignment="CENTER">
            <!-- Calendario en grid -->
            <GridPane fx:id="gridCalendario" 
                     hgap="2" vgap="2" 
                     alignment="CENTER"
                     style="-fx-border-color: #333333; -fx-border-width: 2;">
                <!-- Las celdas se generan dinámicamente en el controlador -->
            </GridPane>
            
            <!-- Leyenda de colores -->
            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10;">
                <Label text="Leyenda:"/>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="ORANGE"/>
                    <Label text="Planificación"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="GREEN"/>
                    <Label text="Confirmado"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="BLUE"/>
                    <Label text="En Ejecución"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <javafx.scene.shape.Circle radius="5" fill="GRAY"/>
                    <Label text="Finalizado"/>
                </HBox>
            </HBox>
        </VBox>
    </center>
    
    <!-- Panel lateral derecho: Eventos del día seleccionado -->
    <right>
        <VBox spacing="15" prefWidth="300" style="-fx-padding: 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 0 1;">
            <Label text="Eventos del Día" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            
            <!-- Fecha seleccionada -->
            <Label fx:id="lblFechaSeleccionada" text="Seleccione una fecha" 
                   style="-fx-font-size: 14px; -fx-text-fill: #666666;" 
                   wrapText="true"/>
            
            <!-- Lista de eventos -->
            <ListView fx:id="listEventosDia" prefHeight="400">
                <!-- Los eventos se cargan dinámicamente -->
            </ListView>
            
            <!-- Instrucciones -->
            <Label text="Haga doble clic en un evento para gestionarlo" 
                   style="-fx-font-size: 12px; -fx-text-fill: #999999;" 
                   wrapText="true"/>
        </VBox>
    </right>
    
</BorderPane>
