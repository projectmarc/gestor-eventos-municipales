<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gov.municipio.controller.PersonasController">
    <VBox spacing="10">
        <Label text="Gestión de Personas" fx:id="lblTitulo"/>
        <HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Añadir Persona" fx:id="btnAgregar"/>
        </HBox>
        <TextField promptText="Buscar..." fx:id="txtBuscar"/>
        <ComboBox fx:id="cbRol" promptText="Filtrar por rol"/>
    </VBox>
</StackPane>