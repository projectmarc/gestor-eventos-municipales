<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gov.municipio.controller.BuscarContenidoDialogController"
      styleClass="dialog-pane" 
      stylesheets="@../css/material-base.css,@../css/material-components.css"
      prefWidth="350">
    
    <Label fx:id="lblTitulo" text="Agregar Contenido" styleClass="text-title-medium"/>
    
    <VBox spacing="10" styleClass="padding-medium">
        <Label fx:id="lblInstruccion" text="ID del contenido:" styleClass="text-label-large"/>
        <TextField fx:id="txtId" promptText="Ingrese el ID"/>
    </VBox>
    
    <Label fx:id="lblError" text="" visible="false" managed="false" styleClass="text-body-small"/>
    
    <!-- Botones de acción -->
    <HBox spacing="10" styleClass="padding-medium">
        <Button fx:id="btnAceptar" text="Agregar" onAction="#aceptar" styleClass="btn-primary"/>
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" styleClass="btn-outlined"/>
    </HBox>
    
</VBox>
