<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="gov.municipio.controller.CrearEventoController"
            styleClass="content-container"
            stylesheets="@../css/material-base.css,@../css/material-components.css">
    
    <!-- Header con título y breadcrumb -->
    <top>
        <VBox spacing="5" styleClass="padding-large">
            <Label text="Crear evento" styleClass="text-headline-medium"/>
        </VBox>
    </top>
    
    <!-- Formulario principal -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER" maxWidth="600" styleClass="section-container">
            
            <!-- Nombre -->
            <VBox spacing="8">
                <Label text="Nombre *" styleClass="text-label-large"/>
                <TextField fx:id="txtNombre" promptText="Ingrese el nombre del evento"/>
            </VBox>
            
            <!-- Tipo de evento -->
            <VBox spacing="8">
                <Label text="Tipo de evento *" styleClass="text-label-large"/>
                <ComboBox fx:id="cbTipoEvento" promptText="Seleccione un tipo de evento" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Fecha de inicio -->
            <VBox spacing="8">
                <Label text="Fecha de inicio *" styleClass="text-label-large"/>
                <DatePicker fx:id="dpFechaInicio" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Duración -->
            <VBox spacing="8">
                <Label text="Duración (horas) *" styleClass="text-label-large"/>
                <TextField fx:id="txtDuracion" promptText="Ingrese la duración en horas"/>
            </VBox>
            
            <!-- Requiere inscripción -->
            <VBox spacing="8">
                <CheckBox fx:id="chkRequiereInscripcion" text="Requiere inscripción"/>
            </VBox>
            
            <!-- Cupo máximo -->
            <VBox spacing="8">
                <Label text="Cupo máximo" styleClass="text-label-large"/>
                <TextField fx:id="txtCupoMaximo" promptText="Ingrese el cupo máximo" disable="true"/>
            </VBox>
            
        </VBox>
    </center>
    
    <!-- Footer con acciones -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="padding-large">
            <Button fx:id="btnCancelar" text="Cancelar" prefWidth="100" styleClass="btn-outlined"/>
            <Button fx:id="btnCrear" text="Crear" prefWidth="120" defaultButton="true" styleClass="btn-primary"/>
        </HBox>
    </bottom>
    
</BorderPane>
