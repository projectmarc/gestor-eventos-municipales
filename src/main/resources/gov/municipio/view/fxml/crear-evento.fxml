<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gov.municipio.controller.CrearEventoController">
    
    <!-- Header con título y breadcrumb -->
    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="15" left="20" right="20" bottom="15"/>
            </padding>
            <Label text="Crear evento" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    
    <!-- Formulario principal -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER" maxWidth="600">
            <padding>
                <Insets top="30" left="40" right="40" bottom="30"/>
            </padding>
            
            <!-- Nombre -->
            <VBox spacing="8">
                <Label text="Nombre *"/>
                <TextField fx:id="txtNombre" promptText="Ingrese el nombre del evento"/>
            </VBox>
            
            <!-- Tipo de evento -->
            <VBox spacing="8">
                <Label text="Tipo de evento *"/>
                <ComboBox fx:id="cbTipoEvento" promptText="Seleccione un tipo de evento" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Fecha de inicio -->
            <VBox spacing="8">
                <Label text="Fecha de inicio *"/>
                <DatePicker fx:id="dpFechaInicio" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Duración -->
            <VBox spacing="8">
                <Label text="Duración (horas) *"/>
                <TextField fx:id="txtDuracion" promptText="Ingrese la duración en horas"/>
            </VBox>
            
            <!-- Requiere inscripción -->
            <VBox spacing="8">
                <CheckBox fx:id="chkRequiereInscripcion" text="Requiere inscripción"/>
            </VBox>
            
        </VBox>
    </center>
    
    <!-- Footer con acciones -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="15" left="20" right="20" bottom="15"/>
            </padding>
            <Button fx:id="btnCancelar" text="Cancelar" prefWidth="100"/>
            <Button fx:id="btnCrear" text="Crear" prefWidth="120" defaultButton="true"/>
        </HBox>
    </bottom>
    
</BorderPane>
