<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="eventsListRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1400.0" styleClass="dashboard-root" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gov.municipio.controller.EventsListController">
   <top>
      <!-- Barra de navegación superior -->
      <HBox fx:id="topNavigationBar" alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="topTitleLabel" styleClass="app-title" text="Sistema de Gestión de Eventos Culturales">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="dashboardNavBtn" mnemonicParsing="false" styleClass="nav-button" text="Dashboard" />
            <Button fx:id="eventosNavBtn" mnemonicParsing="false" styleClass="nav-button-active" text="Eventos" />
            <Button fx:id="personasNavBtn" mnemonicParsing="false" styleClass="nav-button" text="Personas" />
            <Button fx:id="calendarioNavBtn" mnemonicParsing="false" styleClass="nav-button" text="Calendario" />
            <Button fx:id="createEventBtn" mnemonicParsing="false" styleClass="create-event-btn" text="+ Crear Evento" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <!-- Contenido principal -->
      <VBox fx:id="mainContent" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Título de la página -->
            <Label fx:id="pageTitle" styleClass="page-title" text="Gestión de Eventos">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            
            <!-- Sección de filtros -->
            <TitledPane fx:id="filtersSection" animated="false" collapsible="false" styleClass="filters-card" text="Filtros y Búsqueda">
               <content>
                  <VBox spacing="15.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <TextField fx:id="searchField" prefWidth="300.0" promptText="Buscar por nombre o organizador..." styleClass="search-field" />
                              <ComboBox fx:id="stateFilter" prefWidth="200.0" promptText="Todos los estados" styleClass="filter-combo" />
                              <ComboBox fx:id="typeFilter" prefWidth="200.0" promptText="Todos los tipos" styleClass="filter-combo" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="clearFiltersBtn" mnemonicParsing="false" styleClass="secondary-button" text="Limpiar Filtros" />
                              <Button fx:id="applyFiltersBtn" mnemonicParsing="false" styleClass="primary-button" text="Aplicar" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </VBox>
               </content>
            </TitledPane>
            
            <!-- Tabla de eventos -->
            <VBox fx:id="tableContainer" styleClass="table-card" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="section-title" text="Lista de Eventos">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="resultsCountLabel" styleClass="results-count" text="0 eventos encontrados" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
                  
                  <TableView fx:id="eventsTable" styleClass="events-table" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre del Evento" />
                        <TableColumn fx:id="colTipo" prefWidth="120.0" text="Tipo" />
                        <TableColumn fx:id="colFechaInicio" prefWidth="130.0" text="Fecha de Inicio" />
                        <TableColumn fx:id="colDuracion" prefWidth="100.0" text="Duración" />
                        <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                        <TableColumn fx:id="colOrganizador" prefWidth="180.0" text="Organizador" />
                        <TableColumn fx:id="colAcciones" prefWidth="120.0" sortable="false" text="Acciones" />
                    </columns>
                     <placeholder>
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label styleClass="empty-state-icon" text="📅">
                                 <font>
                                    <Font size="48.0" />
                                 </font>
                              </Label>
                              <Label styleClass="empty-state-title" text="No hay eventos para mostrar">
                                 <font>
                                    <Font name="System Bold" size="16.0" />
                                 </font>
                              </Label>
                              <Label styleClass="empty-state-subtitle" text="Utiliza los filtros para buscar eventos o crea un nuevo evento" />
                           </children>
                           <padding>
                              <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                           </padding>
                        </VBox>
                     </placeholder>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="15.0" left="0.0" right="0.0" top="0.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
